# Install as /etc/isp-radius/worker.env; owner root:isp-radius, mode 0640.
DATABASE_URL=postgresql://isp_radius:CHANGE_ME@127.0.0.1:5432/isp_radius
LOG_LEVEL=INFO
WORKER_DB_POOL_MIN_SIZE=1
WORKER_DB_POOL_MAX_SIZE=4
RADIUS_WORKER_BATCH_SIZE=10
RADIUS_WORKER_POLL_INTERVAL=1
RADIUS_WORKER_LEASE_SECONDS=120
RADIUS_WORKER_RECOVERY_INTERVAL=15
RADIUS_COA_TIMEOUT_SECONDS=2
RADIUS_COA_TRANSPORT_RETRIES=2
RADIUS_COMMAND_MAX_ATTEMPTS=8
RADIUS_COMMAND_RETRY_BASE_SECONDS=5
RADIUS_COMMAND_RETRY_MAX_SECONDS=900
# Inject NAS shared secrets from a secret manager. Never commit real values.
# RADIUS_NAS_EDGE_01=REPLACE_WITH_MINIMUM_16_BYTE_SECRET
