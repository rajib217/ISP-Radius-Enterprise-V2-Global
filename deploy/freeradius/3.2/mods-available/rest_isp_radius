# FreeRADIUS 3.2.x REST authentication and authorization instance.
# Enable by linking this file into mods-enabled/rest_isp_radius.
rest rest_isp_radius {
    connect_uri = "https://127.0.0.1:8443"
    connect_timeout = 2.0
    read_timeout = 2.0

    tls {
        check_cert = yes
        check_cert_cn = yes
        ca_file = /etc/freeradius/certs/isp-radius-api-ca.pem
    }

    authorize {
        uri = "${..connect_uri}/radius/authorize"
        method = "post"
        body = "post"
        data = "username=%{urlquote:%{User-Name}}&nas_ip=%{urlquote:%{%{Packet-Src-IP-Address}:-%{Packet-Src-IPv6-Address}}}"
        tls = ${..tls}
    }

    authenticate {
        uri = "${..connect_uri}/radius/authenticate"
        method = "post"
        body = "post"
        data = "username=%{urlquote:%{User-Name}}&password=%{urlquote:%{User-Password}}&nas_ip=%{urlquote:%{%{Packet-Src-IP-Address}:-%{Packet-Src-IPv6-Address}}}"
        tls = ${..tls}
    }
}
